# Claude / Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gmail SMTP — for sending notification emails (Nodemailer)
SALES_TEAM_EMAIL=your_sales_team@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Gmail OAuth2 — for reading inbox via Gmail REST API (poller)
# One-time setup: run src/scripts/get-gmail-token.ts locally to generate refresh token
GMAIL_OAUTH_CLIENT_ID=your_oauth_client_id
GMAIL_OAUTH_CLIENT_SECRET=your_oauth_client_secret
GMAIL_OAUTH_REFRESH_TOKEN=your_refresh_token

# Default manager email for Gmail-path proposals
MANAGER_EMAIL=your_manager_email@gmail.com

# Google Service Account — for Google Drive upload
# Paste the entire service account JSON as a single line
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Google Drive folder where proposals are saved
# Get from the folder URL: drive.google.com/drive/folders/{FOLDER_ID}
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id

# Typeform webhook signing secret — set this in Typeform dashboard > Connect > Webhooks
TYPEFORM_WEBHOOK_SECRET=your_typeform_webhook_secret

# Trigger.dev secret key — required by webhook-receiver.ts to trigger tasks from outside Trigger.dev
# Get from: Trigger.dev dashboard > Settings > API Keys
TRIGGER_SECRET_KEY=tr_dev_your_secret_key_here

# Webhook receiver port (optional, defaults to 3000)
PORT=3000
